# Mango Agent - local development environment.
# Copy to .env and fill in. Never commit .env. Loaded by pydantic-settings.
# Required vars fail fast at startup if missing/empty; optional vars default.

# --- Bot instance identity (required) ---
CHANNEL=telegram
BOT_INSTANCE=task-telegram
AGENT_COMMAND=task_management
# Channel credentials (required for the chosen CHANNEL):
TELEGRAM_BOT_TOKEN=
# DISCORD_TOKEN=

# --- Model provider (required) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- PostgreSQL (required) ---
DATABASE_URL=postgresql://mango:mango@postgres:5432/mango
# Components used only by docker-compose.yml for the postgres service:
POSTGRES_USER=mango
POSTGRES_PASSWORD=mango
POSTGRES_DB=mango

# --- Redis (required) ---
REDIS_URL=redis://redis:6379/0

# --- Cloudflare R2 (optional; all-or-nothing) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- LangSmith tracing (optional) ---
# LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# --- Logging / environment (optional) ---
ENV=dev
LOG_LEVEL=INFO
REDACT_SECRETS=true
