# Mango Agent - local development environment.
# Copy to .env and fill in. Never commit .env. Task 03 finalizes full validation.

# --- Bot instance identity (required; bot fails fast if empty) ---
CHANNEL=telegram
BOT_INSTANCE=task-telegram
AGENT_COMMAND=task_management

# --- PostgreSQL (local dev defaults match docker-compose.yml) ---
POSTGRES_USER=mango
POSTGRES_PASSWORD=mango
POSTGRES_DB=mango
DATABASE_URL=postgresql://mango:mango@postgres:5432/mango

# --- Redis (local dev default matches docker-compose.yml) ---
REDIS_URL=redis://redis:6379/0

# --- External managed services (wired in tasks 03/19/20; optional for task 02) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# LANGSMITH_API_KEY=
